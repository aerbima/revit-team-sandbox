<Project>

  <!-- Общие свойства всех проектов песочницы. Повторяют схему рабочего решения:
       одна конфигурация на версию Revit, версия выводится из имени конфигурации. -->

  <PropertyGroup>
    <PlatformTarget>x64</PlatformTarget>                                  <!-- Revit работает только в 64 битах -->
    <Platforms>x64</Platforms>                                            <!-- единственная платформа решения -->
    <LangVersion>latest</LangVersion>                                     <!-- современный C# и для net48 -->
    <Nullable>enable</Nullable>                                           <!-- предупреждения о null -->
    <ImplicitUsings>disable</ImplicitUsings>                              <!-- все using пишутся явно -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>           <!-- XML-комментарии попадают в сборку -->
    <Company>Sandbox</Company>                                            <!-- учебное имя, без брендов заказчика -->
    <Product>Revit Team Sandbox</Product>                                 <!-- имя продукта в свойствах файла -->
    <Configurations>Debug2021;Debug2022;Debug2023;Debug2024;Debug2025;Release2021;Release2022;Release2023;Release2024;Release2025</Configurations> <!-- 5 версий × Debug/Release -->
  </PropertyGroup>

  <!-- Признак проектов с Revit API; true ставится в csproj. Проверяется только в ItemGroup:
       элементы вычисляются после всех свойств, значение из csproj к этому моменту известно. -->
  <PropertyGroup>
    <UsesRevitApi Condition="'$(UsesRevitApi)' == ''">false</UsesRevitApi> <!-- по умолчанию Revit API не нужен -->
  </PropertyGroup>

  <!-- Версия Revit и символ условной компиляции — из имени конфигурации -->
  <PropertyGroup Condition="$(Configuration.Contains('2021'))">
    <RevitVersion>2021</RevitVersion>                                     <!-- Release2021 → 2021 -->
    <DefineConstants>$(DefineConstants);REVIT2021</DefineConstants>       <!-- #if REVIT2021 -->
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('2022'))">
    <RevitVersion>2022</RevitVersion>
    <DefineConstants>$(DefineConstants);REVIT2022</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('2023'))">
    <RevitVersion>2023</RevitVersion>
    <DefineConstants>$(DefineConstants);REVIT2023</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('2024'))">
    <RevitVersion>2024</RevitVersion>
    <DefineConstants>$(DefineConstants);REVIT2024</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('2025'))">
    <RevitVersion>2025</RevitVersion>
    <DefineConstants>$(DefineConstants);REVIT2025</DefineConstants>
  </PropertyGroup>

  <!-- Конфигурация без года (Debug по умолчанию у dotnet format и у новых инструментов) — собираем как 2025,
       иначе версия пакета Revit API получилась бы пустой («.*») и восстановление пакетов упало бы -->
  <PropertyGroup Condition="'$(RevitVersion)' == ''">
    <RevitVersion>2025</RevitVersion>
    <DefineConstants>$(DefineConstants);REVIT2025</DefineConstants>
  </PropertyGroup>

  <!-- Пакеты Revit API — только проектам с UsesRevitApi=true; в выходной каталог не копируются -->
  <ItemGroup Condition="'$(UsesRevitApi)' == 'true'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Фреймворк по умолчанию: net48 для 2021–2024, net8.0-windows для 2025.
       Core и тесты задают свой фреймворк в csproj — он читается позже и побеждает. -->
  <PropertyGroup Condition="'$(RevitVersion)' == '2025'">
    <TargetFramework>net8.0-windows</TargetFramework>                     <!-- Revit 2025 работает на .NET 8 -->
  </PropertyGroup>
  <PropertyGroup Condition="'$(RevitVersion)' != '2025'">
    <TargetFramework>net48</TargetFramework>                              <!-- Revit 2021–2024 работают на .NET Framework 4.8 -->
  </PropertyGroup>

  <!-- Общий выходной каталог build\bin\<версия>\<проект>\ — его забирает CI в артефакт -->
  <PropertyGroup>
    <OutputPath>$(MSBuildThisFileDirectory)build\bin\$(RevitVersion)\$(MSBuildProjectName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath> <!-- без подкаталога net48\ -->
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration.StartsWith('Debug'))">
    <DebugType>full</DebugType>                                           <!-- полная отладочная информация -->
    <Optimize>false</Optimize>                                            <!-- без оптимизации: удобно отлаживать -->
    <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.StartsWith('Release'))">
    <DebugType>portable</DebugType>                                       <!-- компактные pdb -->
    <Optimize>true</Optimize>                                             <!-- оптимизированная сборка -->
    <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
  </PropertyGroup>

  <!-- TASK-TS-04 добавит сюда анализаторы и «предупреждение = ошибка» для Release.
       Файл защищён CODEOWNERS: изменение требует одобрения тимлида. -->

</Project>
